<tal:t i18n:domain="senaite.impress">
  <style type="text/css">
    /* Remove margens padrão do cabeçalho do Senaite */
    .section-header {
      padding: 0 !important;
      margin: 0 !important;
      border: none !important;
    }

    .labpharma-header {
      width: 100%;
      font-family: Arial, sans-serif;
      margin-bottom: 10px;
    }

    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 5px;
    }

    .logo img {
      height: 70px;
    }

    .doc-info {
      text-align: right;
      font-size: 11px;
      font-weight: bold;
    }

    .title-box {
      border: 1px solid #000;
      padding: 8px;
      text-align: center;
    }

    .title-box h1 {
      margin: 0;
      font-size: 16px;
      text-transform: uppercase;
    }
  </style>

  <div id="header-container">
    <div class="header-top">
      <div class="logo">
                        <img src="data:image/png;base64," alt="Labpharma - Consultoria Analítica e Regulatória">

      </div>
      <div class="doc-info">
        FOR.001. Rev. 00<br />
        Página <span class="page"></span> de <span class="topage"></span>
      </div>
    </div>

    <div class="title-box">
      <h1>Certificado de Análise – Controle de Qualidade Nº.: 
          <span tal:replace="here/getAnalysisNumber | string: RASCUNHO"></span> Rev. <span tal:replace="options/revision_number | string:00">00</span>
      </h1>
    </div>
  </div>
</tal:t>
