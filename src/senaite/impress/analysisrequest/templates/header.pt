<tal:t i18n:domain="senaite.impress">
  <style type="text/css">
    .section-header {
      padding: 0 !important;
      margin: 0 !important;
      border: none !important;
    }
    
    .header-labpharma {
      background-image: url("data:image/png;base64,");
      background-size: 100% 100%;
      background-repeat: no-repeat;
      width: 100%;
      height: 120px;
      position: relative;
      display: block;
    }
    
    .brand-name {
      position: absolute;
      top: 25px;
      left: 45px;
      color: #FFFFFF !important;
      font-family: "Montserrat", "Ubuntu", sans-serif;
      font-size: 28pt;
      font-weight: bold;
    }

    .report-title {
      position: absolute;
      top: 35px;
      right: 45px;
      color: #FFFFFF !important;
      font-family: "Montserrat", "Ubuntu", sans-serif;
      font-size: 18pt;
      font-weight: normal;
    }

    .data-overlay {
      position: absolute;
      bottom: 6px;
      left: 45px;   
      color: #FFFFFF !important;
      font-family: "Montserrat", "Ubuntu", sans-serif;
      font-size: 10pt;
      font-weight: bold;
      letter-spacing: 0.5px;
    }

  </style>

  <div class="row section-header no-gutters">
    <div class="header-labpharma">
      <div class="brand-name">labpharma</div>
      <div class="report-title">Relatório de Análises</div>

      <div class="data-overlay">
        N°:
        <span tal:define="field python:hasattr(model, 'getField') and model.getField('report_number')"
              tal:content="python:field.get(model) if field else 'RASCUNHO'"></span>
        &nbsp; / &nbsp; 
        Rev.:
        <span class="rev-overlay" 
              tal:define="field_rev python:hasattr(model, 'getField') and model.getField('report_revision')"
              tal:content="python:field_rev.get(model) if field_rev else 'N.A.'"></span>
      </div>
    </div>
  </div>
</tal:t>
