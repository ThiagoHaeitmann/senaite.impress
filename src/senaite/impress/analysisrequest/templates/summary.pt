<tal:t define="collection view/collection;
               model view/model;
               batch model/Batch;
               client model/Client;
               reporter python:view.current_user;
               specification model/Specification;
               publication_specification model/PublicationSpecification;
               spec python:publication_specification or specification;
               
               /* Variáveis de Vanguarda Labpharma */
               client_sample_id model/getClientSampleID|nothing;
               client_order_num model/getClientOrderNumber|nothing;
               client_lot python:model.getField('LotClient').get(model) if model.getField('LotClient') else '';
               date_expiration python:view.to_localized_time(model.getField('DateExpiration').get(model)) if model.getField('DateExpiration').get(model) else '';
               date_manufactured python:view.to_localized_time(model.getField('Datemanufactured').get(model)) if model.getField('Datemanufactured').get(model) else '';"
       i18n:domain="senaite.impress">

  <div class="row section-summary no-gutters">
    <div class="w-100">
      
      <div class="text-center float-right barcode-container">
        <div class="barcode"
             data-code="code128"
             data-showHRI="true"
             data-barHeight="15"
             data-addQuietZone="true"
             tal:attributes="data-id model/getId">
        </div>
      </div>

      <h1 i18n:translate="">Summary</h1>

      <table class="table table-sm table-condensed table-borderless">
        <colgroup>
          <col style="width:15%"/> <col style="width:35%"/> <col style="width:15%"/> <col style="width:35%"/> </colgroup>
        <tbody>
          <tr>
            <th i18n:translate="">Nome Amostra</th>
            <td tal:content="client_sample_id"/>
            
            <th i18n:translate="">Client SID</th>
            <td tal:content="model/ClientSampleID"/>
          </tr>
          
          <tr>
            <th i18n:translate="">N° Orçamento</th>
            <td tal:content="client_order_num"/>
            
            <th i18n:translate="">Sample Type</th>
            <td tal:content="model/getSampleTypeTitle|nothing"/>
          </tr>

          <tr>
            <th i18n:translate="">Sample ID</th>
            <td>
              <a tal:content="model/getId" tal:attributes="href model/absolute_url"/>
            </td>
            
            <th i18n:translate="">Specification</th>
            <td tal:content="spec/contextual_title|nothing"/>
          </tr>

          <tr>
            <th i18n:translate="">Batch ID</th>
            <td>
              <a tal:condition="batch" tal:content="batch/id" tal:attributes="href batch/absolute_url"/>
              <span tal:condition="not:batch">-</span>
            </td>
            
            <th i18n:translate="">Date Received</th>
            <td tal:content="python:view.to_localized_time(model.DateReceived)"/>
          </tr>

          <tr>
            <th i18n:translate="">Fabricante (Ref)</th>
            <td tal:content="model/getClientReference|nothing"/>
            
            <th i18n:translate="">Date Verified</th>
            <td tal:content="python:view.to_localized_time(model.getDateVerified())"/>
          </tr>

          <tr>
            <th i18n:translate="">Lote do Cliente</th>
            <td tal:content="client_lot"/>
            
            <th i18n:translate="">Date Published</th>
            <td tal:content="python:view.to_localized_time(view.timestamp)"/>
          </tr>

          <tr>
            <th i18n:translate="">Fabricação</th>
            <td tal:content="date_manufactured"/>
            
            <th i18n:translate="">Published by</th>
            <td>
              <span tal:content="reporter/fullname|reporter/username"/>
            </td>
          </tr>

          <tr>
            <th i18n:translate="">Validade</th>
            <td tal:content="date_expiration"/>
            
            <th i18n:translate="">Batch Labels</th>
            <td tal:content="structure python:', '.join(batch.BatchLabels) if batch and batch.BatchLabels else '-'"/>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</tal:t>
